{
  "name": "qq-agent-presets",
  "displayName": "QQ 小鲸鱼（角色预设 + 模式设置 + 控制面板）",
  "version": "1.3.1",
  "description": "把 QQ 小号接进 DeepSeek Harness 当聊天角色：qq-chat 与 qq-chat-v2 两代 preset（单会话 / 群聊仿真），工具守卫只放行 QQ 桥接工具，qq-mode 设置项决定桥接的运行模式与管理员。另带六节「小鲸鱼」面板：生命开关与掉线看护（自动重启、唤醒调整、免打扰时段、合盖保活）、花费与模型（今日花费、当前模型、锁定默认模型）、运行模式、表情包与语音、会话管理、人格角色卡。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./mode": "./mode.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./qq-tool-restrict.mjs": "./qq-tool-restrict.mjs",
    "./qq-self-key.mjs": "./qq-self-key.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "mode.js",
    "client.js",
    "qq-panel.patch.yml",
    "qq-mode.patch.yml",
    "qq-tool-restrict.mjs",
    "qq-self-key.mjs",
    "presets/*.patch.yml",
    "locale/*.json",
    "icon.svg",
    "scripts/tts-sapi.ps1",
    "scripts/tts-kokoro.cjs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "icon": "./icon.svg",
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./qq-panel.patch.yml",
        "./qq-mode.patch.yml",
        "./presets/qq-chat.patch.yml",
        "./presets/qq-chat-v2.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    }
  }
}
